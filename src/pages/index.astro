---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Stats from "../components/Stats.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Certifications from "../components/Certifications.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/profile";
---

<Base
	title={`Portfolio — ${profile.name}`}
	description="Application Support, Software Developer, Moodle LMS Administrator, dan IT Educator — mengembangkan, menerapkan, dan mendukung sistem web serta platform Moodle."
>
	<main>
		<Hero />
		<About />
		<Stats />
		<Experience />
		<Projects />
		<Certifications />
		<Skills />
		<Contact />
	</main>
</Base>
