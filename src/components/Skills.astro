---
import Section from "./ui/Section.astro";
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";
import { skillGroups } from "../data/skills";
---

{skillGroups.length > 0 && (
	<Section id="skills" title="Skills" subtitle="Teknologi yang saya pakai sehari-hari.">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{skillGroups.map((group, i) => (
				<AnimatedWrapper delay={(i % 3) * 80}>
					<h3 class="text-sm font-semibold uppercase tracking-widest text-zinc-500">{group.category}</h3>
					<ul class="mt-3 flex flex-wrap gap-2">
						{group.items.map((item) => (
							<li class="rounded-full border border-zinc-200 px-3 py-1 text-sm dark:border-zinc-800">{item}</li>
						))}
					</ul>
				</AnimatedWrapper>
			))}
		</div>
	</Section>
)}