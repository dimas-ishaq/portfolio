---
import Section from "./ui/Section.astro";
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";
import { experiences } from "../data/experience";
---

{experiences.length > 0 && (
	<Section id="experience" title="Experience" subtitle="Perjalanan kerja.">
		<ol class="ml-3 space-y-10 border-l border-zinc-200 dark:border-zinc-800">
			{experiences.map((item) => (
				<li class="relative pl-8">
					<span class="absolute -left-1.5 top-1.5 h-3 w-3 rounded-full bg-zinc-900 ring-4 ring-white dark:bg-white dark:ring-zinc-950" aria-hidden="true"></span>
					<AnimatedWrapper>
						<p class="text-sm text-zinc-500">{item.period}</p>
						<h3 class="mt-1 text-lg font-semibold">{item.role} · {item.org}</h3>
						<ul class="mt-3 list-disc space-y-1 pl-5 text-zinc-600 dark:text-zinc-400">
							{item.bullets.map((bullet) => <li>{bullet}</li>)}
						</ul>
					</AnimatedWrapper>
				</li>
			))}
		</ol>
	</Section>
)}
