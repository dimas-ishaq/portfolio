---
interface Props {
	id: string;
	title: string;
	subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-20 px-6 py-20 sm:py-28" aria-labelledby={`${id}-title`}>
	<div class="mb-10 max-w-2xl">
		<h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
		{subtitle && <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{subtitle}</p>}
	</div>
	<slot />
</section>
