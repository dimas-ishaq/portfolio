---
import Section from "./ui/Section.astro";
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";
import { projects } from "../data/projects";
---

{
	projects.length > 0 && (
		<Section id="projects" title="Projects" subtitle="Karya pilihan saya.">
			<ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{projects.map((p, i) => (
					<li>
						<AnimatedWrapper delay={(i % 3) * 80}>
							<article class="group h-full overflow-hidden rounded-2xl border border-zinc-200 transition hover:-translate-y-1 hover:shadow-lg dark:border-zinc-800">
								{p.image && (
									<img
										src={p.image}
										alt={p.title}
										loading="lazy"
										class="aspect-video w-full object-cover"
									/>
								)}
								<div class="p-5">
									<h3 class="text-lg font-semibold">{p.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.desc}</p>
									<ul class="mt-3 flex flex-wrap gap-2" aria-label="Tech stack">
										{p.tags.map((t) => (
											<li class="rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
												{t}
											</li>
										))}
									</ul>
									{p.link && (
										<a
											href={p.link}
											target="_blank"
											rel="noopener"
											aria-label={`Lihat project ${p.title}`}
											class="mt-4 inline-block text-sm font-medium underline underline-offset-4 hover:no-underline"
										>
											Lihat project →
										</a>
									)}
								</div>
							</article>
						</AnimatedWrapper>
					</li>
				))}
			</ul>
		</Section>
	)
}
