---
import Section from "./ui/Section.astro";
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";

interface Props {
	email: string;
}
const { email } = Astro.props;
---

<Section id="contact" title="Contact" subtitle="Punya ide atau project? Mari ngobrol.">
	<AnimatedWrapper>
		<div class="flex flex-wrap items-center gap-4">
			<a
				href={`mailto:${email}`}
				class="rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
				>Email saya</a
			>
			<span class="text-sm text-zinc-500">{email}</span>
		</div>
	</AnimatedWrapper>
</Section>
