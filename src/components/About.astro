---
import Section from "./ui/Section.astro";
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";
---

<Section id="about" title="About" subtitle="Sekilas tentang saya.">
	<AnimatedWrapper>
		<div class="prose max-w-2xl dark:prose-invert">
			<p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
				Saya developer yang fokus pada web cepat dan ringan. Saya suka mengubah ide jadi
				antarmuka yang halus, aksesibel, dan gampang dipakai.
			</p>
			<p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
				Stack utama saya: TypeScript, Astro, Tailwind — dengan animasi secukupnya yang tidak
				mengorbankan performa.
			</p>
		</div>
	</AnimatedWrapper>
</Section>
