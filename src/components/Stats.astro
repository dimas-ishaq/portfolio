---
import AnimatedWrapper from "./ui/AnimatedWrapper.astro";
import { profile } from "../data/profile";
---

{
	profile.stats.length > 0 && (
		<section id="stats" class="border-y border-zinc-200 dark:border-zinc-800" aria-label="Statistik profesional">
			<dl class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-12 lg:grid-cols-4">
				{profile.stats.map((stat, i) => (
					<AnimatedWrapper delay={(i % 4) * 80}>
						<div class="text-center lg:text-left">
							<dt class="order-2 mt-1 block text-sm text-zinc-500">{stat.label}</dt>
							<dd class="text-3xl font-bold tracking-tight">{stat.value}</dd>
						</div>
					</AnimatedWrapper>
				))}
			</dl>
		</section>
	)
}
